{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl":".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@assets/*": ["assets/*"],
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.jsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "assets.d.ts",
  ]
}
